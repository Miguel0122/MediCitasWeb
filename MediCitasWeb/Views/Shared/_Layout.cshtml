<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MediCitas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/medicitas.css">
</head>
<body>

    @* ── SPLASH SCREEN ─────────────────────────────────────────────────────── *@
    <div id="mediSplash">
        <div class="splash-rings">
            <div class="splash-ring r1"></div>
            <div class="splash-ring r2"></div>
            <div class="splash-ring r3"></div>
        </div>

        <div class="splash-heart">
            <svg width="108" height="100" viewBox="0 0 108 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <clipPath id="heartClip">
                        <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z" />
                    </clipPath>
                </defs>
                <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z"
                      fill="white" fill-opacity="0.95" />
                <g clip-path="url(#heartClip)">
                    <svg x="8" y="28" width="84" height="44" viewBox="0 0 168 44" overflow="hidden">
                        <g class="ecg-ticker">
                            <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                      fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                            <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                      fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"
                                      transform="translate(168,0)" />
                        </g>
                    </svg>
                </g>
            </svg>
        </div>

        <div class="splash-brand">MediCitas</div>
        <div class="splash-sub">Sistema de salud digital</div>

        <div class="splash-dots">
            <span class="splash-label">Cargando</span>
            <div class="sdot"></div>
            <div class="sdot"></div>
            <div class="sdot"></div>
        </div>
        <div class="splash-track"><div class="splash-fill" id="splashFill"></div></div>
    </div>

    @* ── OVERLAY DE CARGA (para páginas lentas) ────────────────────────────── *@
    <div id="pageLoader" style="display:none;">
        <div class="loader-heart">
            <svg width="72" height="67" viewBox="0 0 108 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <clipPath id="heartClipLoader">
                        <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z" />
                    </clipPath>
                </defs>
                <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z"
                      fill="white" fill-opacity="0.95" />
                <g clip-path="url(#heartClipLoader)">
                    <svg x="8" y="28" width="84" height="44" viewBox="0 0 168 44" overflow="hidden">
                        <g class="ecg-ticker">
                            <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                      fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                            <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                      fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"
                                      transform="translate(168,0)" />
                        </g>
                    </svg>
                </g>
            </svg>
        </div>
        <div class="loader-text">Procesando</div>
    </div>

    @* ── NAVBAR ────────────────────────────────────────────────────────────── *@
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm" id="navApp">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="@Url.Action("Dashboard", "Home")">
                <svg class="nav-heart" width="26" height="24" viewBox="0 0 108 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <clipPath id="heartClipNav">
                            <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z" />
                        </clipPath>
                    </defs>
                    <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z"
                          fill="white" fill-opacity="0.95" />
                    <g clip-path="url(#heartClipNav)">
                        <svg x="8" y="28" width="84" height="44" viewBox="0 0 168 44" overflow="hidden">
                            <g class="ecg-ticker">
                                <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                          fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                                <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                          fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"
                                          transform="translate(168,0)" />
                            </g>
                        </svg>
                    </g>
                </svg>
                MEDICITAS
            </a>

            <div class="d-flex align-items-center gap-3">
                <a href="@Url.Action("ChatBot", "Chat")" class="btn btn-sm btn-asistente-nav rounded-pill px-3 d-flex align-items-center">
                    <span class="pulse-dot me-1"></span>
                    <i class="bi bi-robot me-1"></i>
                    <span class="d-none d-sm-inline">Asistente</span>
                </a>

                <div class="text-white border-start ps-3 d-flex align-items-center">
                    <span class="small me-3 d-none d-md-inline">@Session["usuario"]</span>
                    <a href="@Url.Action("Login", "Auth")" class="btn btn-sm btn-light text-danger fw-bold rounded-pill">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vue@3.4.21/dist/vue.global.prod.js"></script>
    <script src="~/Scripts/app/medicitas-splash.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
