@{
    ViewBag.Title = "Centro de Reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="reportApp" class="container-fluid py-4 px-4">

    <!-- HEADER -->
    <div class="row align-items-center mb-4">
        <div class="col">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                    <i class="bi bi-shield-shaded me-1"></i>Centro de Inteligencia
                </span>
            </div>
            <h2 class="fw-bold m-0">Centro de Reportes</h2>
            <p class="text-muted mt-1">Genera y exporta informes del sistema en PDF</p>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("PanelAdmin", "Admin")" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Volver al Panel
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- PANEL DE FILTROS -->
        <div class="col-xl-3 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white p-4 border-0">
                    <h6 class="fw-bold mb-0"><i class="bi bi-sliders me-2"></i>Configurar Reporte</h6>
                </div>
                <div class="card-body p-4">

                    <!-- Tipo de reporte -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Tipo de Informe</label>
                        <div class="d-flex flex-column gap-2">
                            <label v-for="tipo in tiposReporte" :key="tipo.value"
                                   class="tipo-card p-3 rounded border cursor-pointer"
                                   :class="{ 'border-primary bg-primary-subtle': filtros.tipo === tipo.value }"
                                   style="cursor:pointer">
                                <input type="radio" v-model="filtros.tipo" :value="tipo.value" class="d-none">
                                <div class="d-flex align-items-center gap-2">
                                    <i :class="['bi', tipo.icono, filtros.tipo === tipo.value ? 'text-primary' : 'text-muted']"></i>
                                    <div>
                                        <div class="fw-bold small">{{ tipo.label }}</div>
                                        <div class="text-muted" style="font-size:11px">{{ tipo.desc }}</div>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Rango de fechas -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted">Periodo</label>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Desde</label>
                            <input type="date" v-model="filtros.fechaInicio" class="form-control bg-light border-0">
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-1">Hasta</label>
                            <input type="date" v-model="filtros.fechaFin" class="form-control bg-light border-0">
                        </div>
                        <div class="d-flex gap-1 mt-2 flex-wrap">
                            <button class="btn btn-xs btn-outline-secondary btn-sm py-0 px-2" @@click="setPeriodo('hoy')">Hoy</button>
                            <button class="btn btn-xs btn-outline-secondary btn-sm py-0 px-2" @@click="setPeriodo('semana')">Semana</button>
                            <button class="btn btn-xs btn-outline-secondary btn-sm py-0 px-2" @@click="setPeriodo('mes')">Mes</button>
                            <button class="btn btn-xs btn-outline-secondary btn-sm py-0 px-2" @@click="setPeriodo('año')">Año</button>
                        </div>
                    </div>

                    <!-- Filtros por tipo -->
                    <div class="mb-4" v-if="filtros.tipo === 'Citas'">
                        <label class="form-label small fw-bold text-uppercase text-muted">Filtros de Citas</label>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Especialidad</label>
                            <select v-model="filtros.especialidad" class="form-select form-select-sm bg-light border-0">
                                <option value="">Todas las especialidades</option>
                                <option>Medicina General</option>
                                <option>Pediatría</option>
                                <option>Cardiología</option>
                                <option>Odontología</option>
                                <option>Dermatología</option>
                                <option>Ginecología</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-1">Estado</label>
                            <select v-model="filtros.estadoCita" class="form-select form-select-sm bg-light border-0">
                                <option value="">Todos los estados</option>
                                <option>Activa</option>
                                <option>Atendida</option>
                                <option>Cancelada</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4" v-if="filtros.tipo === 'Usuarios'">
                        <label class="form-label small fw-bold text-uppercase text-muted">Filtros de Usuarios</label>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Rol</label>
                            <select v-model="filtros.rol" class="form-select form-select-sm bg-light border-0">
                                <option value="">Todos los roles</option>
                                <option>Paciente</option>
                                <option>Doctor</option>
                                <option>Administrador</option>
                            </select>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" v-model="filtros.soloActivos" id="switchActivos">
                            <label class="form-check-label small" for="switchActivos">Solo usuarios activos</label>
                        </div>
                    </div>

                    <div class="mb-4" v-if="filtros.tipo === 'Doctores'">
                        <label class="form-label small fw-bold text-uppercase text-muted">Filtros de Doctores</label>
                        <select v-model="filtros.especialidad" class="form-select form-select-sm bg-light border-0">
                            <option value="">Todas las especialidades</option>
                            <option>Medicina General</option>
                            <option>Pediatría</option>
                            <option>Cardiología</option>
                            <option>Odontología</option>
                            <option>Dermatología</option>
                            <option>Ginecología</option>
                        </select>
                    </div>

                    <!-- Botones -->
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary fw-bold py-2"
                                @@click="previsualizarReporte"
                                :disabled="cargando">
                            <span v-if="cargando" class="spinner-border spinner-border-sm me-2"></span>
                            <i v-else class="bi bi-eye me-2"></i>
                            {{ cargando ? 'Cargando...' : 'Previsualizar' }}
                        </button>
                        <button class="btn btn-danger fw-bold py-2"
                                @@click="descargarReporte"
                                :disabled="!datosReporte || cargando">
                            <i class="bi bi-file-earmark-pdf me-2"></i>
                            Descargar PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANEL DE PREVISUALIZACIÓN -->
        <div class="col-xl-9 col-lg-8">
            <div class="card border-0 shadow-sm h-100">

                <div v-if="!datosReporte && !cargando" class="card-body d-flex flex-column align-items-center justify-content-center py-5 text-center" style="min-height:500px">
                    <div class="mb-4" style="width:80px;height:80px;background:#f0f4ff;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-bar-chart-line text-primary fs-2"></i>
                    </div>
                    <h5 class="fw-bold">Listo para generar</h5>
                    <p class="text-muted">Configura los filtros y haz clic en <strong>Previsualizar</strong></p>
                </div>

                <div v-if="cargando" class="card-body d-flex align-items-center justify-content-center" style="min-height:500px">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;"></div>
                        <p class="text-muted">Consultando datos...</p>
                    </div>
                </div>

                <div v-if="datosReporte && !cargando" class="card-body p-0">
                    <div class="p-4 border-bottom" style="background:linear-gradient(135deg,#0d6efd,#0b5ed7);color:white;border-radius:12px 12px 0 0">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold fs-5 mb-1">
                                    <i class="bi bi-hospital me-2"></i>MediCitas — {{ tituloReporte }}
                                </div>
                                <div style="opacity:0.85;font-size:13px">
                                    Generado: {{ fechaGeneracion }} &nbsp;|&nbsp;
                                    Periodo: {{ filtros.fechaInicio || 'Inicio' }} al {{ filtros.fechaFin || 'Hoy' }}
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold fs-4">{{ datosReporte.length }}</div>
                                <div style="font-size:12px;opacity:0.85">registros</div>
                            </div>
                        </div>

                        <div class="row g-2 mt-3" v-if="kpis.length > 0">
                            <div class="col-auto" v-for="kpi in kpis" :key="kpi.label">
                                <div class="px-3 py-2 rounded" style="background:rgba(255,255,255,0.15);font-size:12px">
                                    <div style="opacity:0.8">{{ kpi.label }}</div>
                                    <div class="fw-bold">{{ kpi.valor }}</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height:520px;overflow-y:auto">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="sticky-top bg-white border-bottom">
                                <tr class="text-muted small text-uppercase">
                                    <th v-for="col in columnas" :key="col.key" class="py-3 px-4" @@click="ordenarPor(col.key)">
                                        {{ col.label }}
                                        <i v-if="orden.key === col.key" :class="['bi', orden.asc ? 'bi-arrow-up' : 'bi-arrow-down']"></i>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(fila, i) in datosPaginados" :key="i" class="border-bottom">
                                    <td v-for="col in columnas" :key="col.key" class="py-3 px-4">
                                        <span v-if="col.tipo === 'badge'" :class="['badge', 'rounded-pill', 'px-3', getBadgeClass(fila[col.key])]">
                                            {{ fila[col.key] }}
                                        </span>
                                        <span v-else>{{ fila[col.key] || '—' }}</span>
                                    </td>
                                </tr>
                                <tr v-if="datosOrdenados.length === 0">
                                    <td :colspan="columnas.length" class="text-center py-5">No hay registros</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 border-top bg-light">
                        <small class="text-muted">Mostrando {{ (pagina-1)*porPagina+1 }}-{{ Math.min(pagina*porPagina, datosOrdenados.length) }} de {{ datosOrdenados.length }} registros</small>
                        <nav v-if="totalPaginasPreview > 1">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item" :class="{disabled: pagina===1}"><a class="page-link" href="#" @@click.prevent="pagina--"><i class="bi bi-chevron-left"></i></a></li>
                                <li v-for="p in totalPaginasPreview" :key="p" class="page-item" :class="{active: p===pagina}"><a class="page-link" href="#" @@click.prevent="pagina=p">{{ p }}</a></li>
                                <li class="page-item" :class="{disabled: pagina===totalPaginasPreview}"><a class="page-link" href="#" @@click.prevent="pagina++"><i class="bi bi-chevron-right"></i></a></li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        const { createApp } = Vue;
        createApp({
            data() {
                return {
                    cargando: false,
                    datosReporte: null,
                    columnas: [],
                    kpis: [],
                    pagina: 1,
                    porPagina: 15,
                    orden: { key: '', asc: true },
                    fechaGeneracion: '',
                    filtros: {
                        tipo: 'Citas',
                        fechaInicio: '',
                        fechaFin: '',
                        especialidad: '',
                        estadoCita: '',
                        rol: '',
                        soloActivos: true
                    },
                    tiposReporte: [
                        { value: 'Citas', label: 'Informe de Citas', icono: 'bi-calendar-check', desc: 'Todas las citas con filtros' },
                        { value: 'Usuarios', label: 'Directorio de Usuarios', icono: 'bi-people-fill', desc: 'Pacientes y personal' },
                        { value: 'Doctores', label: 'Equipo Médico', icono: 'bi-person-badge', desc: 'Doctores y especialidades' }
                    ]
                };
            },
            computed: {
                tituloReporte() {
                    const t = this.tiposReporte.find(t => t.value === this.filtros.tipo);
                    return t ? t.label : '';
                },
                datosOrdenados() {
                    if (!this.datosReporte) return [];
                    if (!this.orden.key) return this.datosReporte;
                    return [...this.datosReporte].sort((a, b) => {
                        const va = (a[this.orden.key] || '').toString().toLowerCase();
                        const vb = (b[this.orden.key] || '').toString().toLowerCase();
                        return this.orden.asc ? va.localeCompare(vb) : vb.localeCompare(va);
                    });
                },
                datosPaginados() { const ini = (this.pagina - 1) * this.porPagina; return this.datosOrdenados.slice(ini, ini + this.porPagina); },
                totalPaginasPreview() { return Math.ceil((this.datosOrdenados.length || 0) / this.porPagina); }
            },
            watch: { 'filtros.tipo'() { this.datosReporte = null; this.pagina = 1; } },
            methods: {
                setPeriodo(p) {
                    const hoy = new Date();
                    const fmt = d => d.toISOString().split('T')[0];
                    this.filtros.fechaFin = fmt(hoy);
                    if (p === 'hoy') this.filtros.fechaInicio = fmt(hoy);
                    if (p === 'semana') { const d = new Date(hoy); d.setDate(d.getDate() - 7); this.filtros.fechaInicio = fmt(d); }
                    if (p === 'mes') { const d = new Date(hoy); d.setMonth(d.getMonth() - 1); this.filtros.fechaInicio = fmt(d); }
                    if (p === 'año') { const d = new Date(hoy); d.setFullYear(d.getFullYear() - 1); this.filtros.fechaInicio = fmt(d); }
                },
                async previsualizarReporte() {
                    this.cargando = true;
                    this.datosReporte = null;
                    this.pagina = 1;
                    try {
                        const params = new URLSearchParams({
                            tipo: this.filtros.tipo,
                            fechaInicio: this.filtros.fechaInicio,
                            fechaFin: this.filtros.fechaFin,
                            especialidad: this.filtros.especialidad,
                            estadoCita: this.filtros.estadoCita,
                            rol: this.filtros.rol,
                            soloActivos: this.filtros.soloActivos
                        });
                        const res = await fetch('/Admin/ObtenerDatosReporte?' + params);
                        const data = await res.json();
                        if (data.success) {
                            this.datosReporte = data.filas;
                            this.columnas = data.columnas;
                            this.kpis = data.kpis || [];
                            this.fechaGeneracion = new Date().toLocaleString('es-CO');
                        } else { alert('Error: ' + data.message); }
                    } catch (e) { alert('Error de conexion'); }
                    finally { this.cargando = false; }
                },
                ordenarPor(key) { if (this.orden.key === key) this.orden.asc = !this.orden.asc; else { this.orden.key = key; this.orden.asc = true; } },
                descargarReporte() {
                    if (!this.datosReporte) return;
                    const params = new URLSearchParams({
                        tipo: this.filtros.tipo,
                        fechaInicio: this.filtros.fechaInicio,
                        fechaFin: this.filtros.fechaFin,
                        especialidad: this.filtros.especialidad,
                        estadoCita: this.filtros.estadoCita,
                        rol: this.filtros.rol,
                        soloActivos: this.filtros.soloActivos,
                        formato: 'pdf'
                    });
                    window.location.href = '/Admin/DescargarReporte?' + params;
                },
                getBadgeClass(val) {
                    const map = {
                        'Activa': 'bg-primary-subtle text-primary',
                        'Atendida': 'bg-success-subtle text-success',
                        'Cancelada': 'bg-danger-subtle text-danger',
                        'Doctor': 'bg-info-subtle text-info',
                        'Paciente': 'bg-primary-subtle text-primary',
                        'Administrador': 'bg-dark text-white',
                        'Activo': 'bg-success-subtle text-success',
                        'Inactivo': 'bg-secondary-subtle text-secondary'
                    };
                    return map[val] || 'bg-secondary-subtle text-secondary';
                }
            }
        }).mount('#reportApp');
    </script>
}