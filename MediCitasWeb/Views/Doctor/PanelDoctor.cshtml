@model List<MediCitasWeb.Models.CitaPacienteViewModel>
@{
    ViewBag.Title = "Panel del Doctor";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Capturamos la hora real del servidor para evitar el truco del cambio de hora en el PC
    var horaServidor = DateTime.Now.ToString("HH:mm");
}

<div id="doctorApp" v-cloak>

    @* ── HEADER ─────────────────────────────────────────────────────────── *@
    <div class="row align-items-center mb-4">
        <div class="col">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                    <i class="bi bi-person-badge me-1"></i>@ViewBag.Especialidad
                </span>
            </div>
            <h2 class="fw-bold m-0">Dr. @ViewBag.NombreDoctor</h2>
            <p class="text-muted mt-1">Agenda médica — <span id="fechaHoy"></span></p>
        </div>
        <div class="col-auto d-flex gap-2">
            <span class="badge bg-primary px-3 py-2 fs-6">
                <i class="bi bi-calendar-check me-1"></i>{{ citas.length }} citas totales
            </span>
        </div>
    </div>

    @* ── ALERTAS IA ──────────────────────────────────────────────────────── *@
    <div v-if="alertasIA.length > 0" class="mb-4">
        <div v-for="alerta in alertasIA" :key="alerta.titulo"
             class="alert border-0 d-flex align-items-center gap-3 mb-2"
             :class="'alert-' + alerta.tipo" style="border-radius:10px">
            <i :class="['bi', alerta.icono, 'fs-5']"></i>
            <div>
                <strong>{{ alerta.titulo }}</strong> — {{ alerta.mensaje }}
            </div>
        </div>
    </div>

    @* ── FILTROS (RESTAURADOS) ───────────────────────────────────────────── *@
    <div class="card border-0 shadow-sm mb-4" style="border-radius:12px">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                        <input type="text" v-model="filtro" class="form-control bg-light border-0"
                               placeholder="Buscar por nombre o documento...">
                    </div>
                </div>
                <div class="col-md-3">
                    <input type="date" v-model="filtroFecha" class="form-control bg-light border-0">
                </div>
                <div class="col-md-2">
                    <select v-model="filtroEstado" class="form-select bg-light border-0">
                        <option value="">Todos los estados</option>
                        <option>Activa</option>
                        <option>Atendida</option>
                        <option>Inasistencia</option>
                        <option>Cancelada</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button @@click="limpiarFiltros" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-circle me-1"></i>Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ── TABLA DE CITAS ──────────────────────────────────────────────────── *@
    <div class="card border-0 shadow-sm" style="border-radius:12px">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small text-uppercase">
                            <th class="px-4 py-3">Paciente</th>
                            <th>Documento</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Estado</th>
                            <th>Riesgo IA</th>
                            <th class="text-end px-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-if="citasFiltradas.length === 0">
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-4 d-block mb-2"></i>
                                No hay citas con los filtros aplicados
                            </td>
                        </tr>
                        <tr v-for="cita in citasFiltradas" :key="cita.id"
                            class="border-bottom"
                            :class="{'table-warning': cita.esRetrasada && cita.estado === 'Activa'}">
                            <td class="px-4 py-3">
                                <div class="fw-bold">{{ cita.nombre }}</div>
                            </td>
                            <td><span class="badge bg-light text-dark"># {{ cita.documento }}</span></td>
                            <td>{{ cita.fecha }}</td>
                            <td>
                                <span :class="{'text-danger fw-bold': cita.esRetrasada && cita.estado === 'Activa'}">
                                    <i v-if="cita.esRetrasada && cita.estado === 'Activa'" class="bi bi-clock-history me-1"></i>
                                    {{ cita.hora }}
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3"
                                      :class="claseEstado(cita.estado)">
                                    {{ cita.estado }}
                                </span>
                            </td>
                            <td>
                                <span v-if="cita.riesgo" class="badge rounded-pill px-3"
                                      :class="claseRiesgo(cita.riesgo.nivel)">
                                    <i class="bi bi-activity me-1"></i>
                                    {{ cita.riesgo.nivel }} ({{ cita.riesgo.porcentaje }}%)
                                </span>
                                <span v-else-if="cargandoRiesgos" class="text-muted small">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </span>
                                <span v-else class="text-muted small">—</span>
                            </td>
                            <td class="text-end px-4">
                                <button class="btn btn-sm btn-outline-primary me-1" @@click="verDetalle(cita)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button v-if="cita.estado === 'Activa'"
                                        class="btn btn-sm btn-success me-1"
                                        @@click="cambiarEstado(cita, 'Atendida')">
                                    <i class="bi bi-check-circle"></i>
                                </button>
                                <button v-if="cita.estado === 'Activa'"
                                        class="btn btn-sm btn-outline-danger"
                                        @@click="cambiarEstado(cita, 'Cancelada')">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── MODAL DETALLE (RESTAURADO COMPLETO) ────────────────────────────── *@
    <div class="modal fade" id="modalDetallePaciente" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
                <div class="modal-header border-0 bg-primary text-white p-4" style="border-radius:16px 16px 0 0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-badge me-2"></i>Detalle del Paciente
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4" v-if="citaSeleccionada">

                    @* Resumen IA *@
                    <div class="p-3 mb-4 rounded-3" style="background:#f0f7ff;border-left:4px solid #0d6efd">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-stars text-primary"></i>
                            <strong class="small text-primary">Resumen generado por IA</strong>
                            <span v-if="cargandoResumen" class="spinner-border spinner-border-sm text-primary ms-1"></span>
                        </div>
                        <p class="mb-0 small" v-if="!cargandoResumen">{{ resumenIA || 'Generando resumen...' }}</p>
                    </div>

                    @* Info de la cita *@
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded-3">
                                <h6 class="fw-bold mb-3 small text-uppercase text-muted">Datos de la Cita</h6>
                                <p class="mb-1 small"><strong>Paciente:</strong> {{ citaSeleccionada.nombre }}</p>
                                <p class="mb-1 small"><strong>Documento:</strong> {{ citaSeleccionada.documento }}</p>
                                <p class="mb-1 small"><strong>Fecha:</strong> {{ citaSeleccionada.fecha }}</p>
                                <p class="mb-1 small"><strong>Hora:</strong> {{ citaSeleccionada.hora }}</p>
                                <p class="mb-1 small"><strong>Tipo:</strong> {{ citaSeleccionada.tipo }}</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded-3">
                                <h6 class="fw-bold mb-3 small text-uppercase text-muted">Análisis de Riesgo</h6>
                                <div v-if="citaSeleccionada.riesgo">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge fs-6" :class="claseRiesgo(citaSeleccionada.riesgo.nivel)">
                                            Riesgo {{ citaSeleccionada.riesgo.nivel }}: {{ citaSeleccionada.riesgo.porcentaje }}%
                                        </span>
                                    </div>
                                    <p class="small text-muted mb-0">{{ citaSeleccionada.riesgo.mensaje }}</p>
                                </div>
                                <p v-else class="text-muted small">Sin datos de riesgo disponibles.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4" v-if="citaSeleccionada.estado === 'Activa'">
                        <button class="btn btn-success" @@click="cambiarEstado(citaSeleccionada, 'Atendida'); cerrarModal()">
                            <i class="bi bi-check-circle me-2"></i>Marcar como Atendida
                        </button>
                        <button class="btn btn-outline-danger" @@click="cambiarEstado(citaSeleccionada, 'Cancelada'); cerrarModal()">
                            <i class="bi bi-x-circle me-2"></i>Cancelar Cita
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script>
const { createApp } = Vue;

const citasData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
    Model.Select(c => new {
        id          = c.IdCita,
        nombre      = c.NombrePaciente,
        documento   = c.Documento,
        fecha       = c.Fecha.ToString("dd/MM/yyyy"),
        fechaSort   = c.Fecha.ToString("yyyy-MM-dd"),
        hora        = c.Hora.ToString(@"hh\:mm"),
        especialidad= c.Especialidad,
        tipo        = c.Tipo,
        estado      = c.Estado,
        pacienteId  = c.IdPaciente,
        riesgo      = (object)null
    }).ToList()
));

createApp({
    data() {
        return {
            citas: citasData,
            filtro: '',
            filtroFecha: '',
            filtroEstado: '',
            horaServidor: '@horaServidor',
            cargandoRiesgos: false,
            citaSeleccionada: null,
            resumenIA: '',
            cargandoResumen: false,
            alertasIA: [],
            modalInstance: null
        };
    },
    computed: {
        citasFiltradas() {
            return this.citas.filter(c => {
                const txt = this.filtro.toLowerCase();
                const coincideTexto = !txt || c.nombre.toLowerCase().includes(txt) || c.documento.includes(txt);
                const coincideFecha = !this.filtroFecha || c.fechaSort === this.filtroFecha;
                const coincideEstado = !this.filtroEstado || c.estado === this.filtroEstado;
                return coincideTexto && coincideFecha && coincideEstado;
            }).map(c => {
                // Lógica de retraso comparando con hora del servidor
                return { ...c, esRetrasada: c.hora < this.horaServidor };
            });
        }
    },
    mounted() {
        document.getElementById('fechaHoy').textContent = new Date().toLocaleDateString('es-CO', {weekday:'long', year:'numeric', month:'long', day:'numeric'});
        const el = document.getElementById('modalDetallePaciente');
        if (el) this.modalInstance = new bootstrap.Modal(el);
        this.cargarRiesgosIA();
    },
    methods: {
        claseEstado(estado) {
            return {
                'bg-primary': estado === 'Activa',
                'bg-success': estado === 'Atendida',
                'bg-danger': estado === 'Cancelada',
                'bg-warning text-dark': estado === 'Inasistencia'
            };
        },
        claseRiesgo(nivel) {
            return {
                'bg-danger': nivel === 'alto',
                'bg-warning text-dark': nivel === 'medio',
                'bg-success': nivel === 'bajo'
            };
        },
        async cargarRiesgosIA() {
            if (!this.citas.length) return;
            this.cargandoRiesgos = true;
            try {
                const res = await fetch('/IA/RiesgosBatch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(this.citas.map(c => ({ citaId: c.id, pacienteId: c.pacienteId })))
                });
                const data = await res.json();
                if (data.success) {
                    data.riesgos.forEach(r => {
                        const cita = this.citas.find(c => c.id === r.citaId);
                        if (cita) cita.riesgo = r.riesgo;
                    });
                }
            } catch(e) { console.error(e); }
            finally { this.cargandoRiesgos = false; }
        },
        async verDetalle(cita) {
            this.citaSeleccionada = cita;
            this.resumenIA = '';
            this.cargandoResumen = true;
            this.modalInstance?.show();
            try {
                const res = await fetch('/IA/ResumenPaciente?pacienteId=' + cita.pacienteId);
                const data = await res.json();
                if (data.success) this.resumenIA = data.resumen;
            } catch(e) { this.resumenIA = 'No se pudo generar el resumen.'; }
            finally { this.cargandoResumen = false; }
        },
        async cambiarEstado(cita, nuevoEstado) {
            try {
                const res = await fetch('/Doctor/CambiarEstadoCita', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `citaId=${cita.id}&estado=${nuevoEstado}`
                });
                const data = await res.json();
                if (data.success) {
                    const idx = this.citas.findIndex(c => c.id === cita.id);
                    if (idx !== -1) this.citas.splice(idx, 1, { ...this.citas[idx], estado: nuevoEstado });
                }
            } catch(e) { alert('Error al cambiar estado'); }
        },
        cerrarModal() { this.modalInstance?.hide(); },
        limpiarFiltros() { this.filtro = ''; this.filtroFecha = ''; this.filtroEstado = ''; }
    }
}).mount('#doctorApp');
    </script>
}