@{
    Layout = null;
    var sesionId = ViewBag.SesionId ?? 0;
    var contexto = Uri.EscapeDataString(ViewBag.ContextoUsuario ?? "");
    var nombre = ViewBag.NombreUsuario ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>ChatBot MediCitas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f4f7fb;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            height: 100vh;
        }

        .chat-container {
            max-width: 900px;
            margin: 20px auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            display: flex;
            flex-direction: column;
            height: calc(100vh - 40px);
        }

        .chat-header {
            background: linear-gradient(135deg, #0d6efd, #4e73df);
            color: white;
            padding: 15px 20px;
            border-radius: 20px 20px 0 0;
        }

        .chat-messages {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
        }

        .message {
            margin-bottom: 15px;
            max-width: 75%;
            padding: 12px 15px;
            border-radius: 15px;
            font-size: 14px;
        }

            .message.user {
                background: #0d6efd;
                color: white;
                margin-left: auto;
                border-bottom-right-radius: 5px;
            }

            .message.bot {
                background: #e9ecef;
                color: #333;
                border-bottom-left-radius: 5px;
            }

        .time {
            font-size: 10px;
            opacity: 0.7;
            margin-top: 5px;
            text-align: right;
        }

        .chat-input {
            display: flex;
            padding: 15px;
            border-top: 1px solid #eee;
        }

            .chat-input input {
                flex: 1;
                border-radius: 30px;
                padding: 10px 15px;
                border: 1px solid #ddd;
            }

            .chat-input button {
                margin-left: 10px;
                border-radius: 30px;
            }

        .typing-indicator {
            padding: 12px 18px;
            background: #e9ecef;
            border-radius: 20px;
            border-bottom-left-radius: 5px;
            display: inline-block;
        }

        .typing-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #999;
            margin: 0 2px;
            animation: typing 1.4s infinite;
        }

            .typing-dot:nth-child(2) {
                animation-delay: 0.2s;
            }

            .typing-dot:nth-child(3) {
                animation-delay: 0.4s;
            }

        @@keyframes typing {
            0%, 60%, 100% {
                transform: translateY(0);
                opacity: 0.5;
            }

            30% {
                transform: translateY(-10px);
                opacity: 1;
            }
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: #28a745;
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(40,167,69,0.7);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(40,167,69,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(40,167,69,0);
            }
        }
    </style>
</head>
<body data-sesion-id="@sesionId"
      data-contexto="@contexto"
      data-nombre="@nombre">

    <div class="chat-container">
        <div class="chat-header d-flex align-items-center">
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-sm btn-light me-2">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div class="text-center flex-grow-1">
                <strong><i class="bi bi-robot"></i> MediBot</strong>
                <div style="font-size:12px; opacity:0.8;">
                    <span class="pulse-dot"></span> Conectado
                </div>
            </div>
            <button class="btn btn-sm btn-light" id="btnLimpiar">
                <i class="bi bi-trash"></i>
            </button>
        </div>

        <div class="chat-messages" id="chatMessages"></div>

        <div id="typingIndicator" class="p-2 ms-2" style="display:none;">
            <div class="d-flex align-items-center gap-2">
                <div class="chat-typing-heart">
                    <svg width="32" height="30" viewBox="0 0 108 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <clipPath id="heartClipTyping">
                                <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z" />
                            </clipPath>
                        </defs>
                        <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z"
                              fill="#0d6efd" fill-opacity="0.15" />
                        <path d="M54 94C54 94 8 64 8 32C8 18 19 8 32 8C40 8 47 12 54 19C61 12 68 8 76 8C89 8 100 18 100 32C100 64 54 94 54 94Z"
                              fill="none" stroke="#0d6efd" stroke-width="3" />
                        <g clip-path="url(#heartClipTyping)">
                            <svg x="8" y="28" width="84" height="44" viewBox="0 0 168 44" overflow="hidden">
                                <g class="ecg-ticker">
                                    <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                              fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                                    <polyline points="0,22 8,22 13,22 18,4 22,40 27,14 31,26 34,20 38,26 42,22 48,22 54,22 58,22 63,4 67,40 72,14 76,26 79,20 83,26 87,22 93,22 99,22 104,22 109,4 113,40 118,14 122,26 125,20 129,26 133,22 139,22 145,22 149,22 154,4 158,40 163,14 167,26 168,22"
                                              fill="none" stroke="#0d6efd" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"
                                              transform="translate(168,0)" />
                                </g>
                            </svg>
                        </g>
                    </svg>
                </div>
                <span style="font-size:13px; color:#6c757d;">MediBot está escribiendo...</span>
            </div>
        </div>

        <div class="chat-input d-flex p-3 border-top">
            <input type="text" id="txtEntrada" class="form-control me-2" placeholder="Escribe tu mensaje..." />
            <button class="btn btn-primary" id="btnEnviar">
                <i class="bi bi-send"></i> Enviar
            </button>
        </div>
    </div>

    <script src="~/Scripts/app/chatbot-app.js"></script>
</body>
</html>
