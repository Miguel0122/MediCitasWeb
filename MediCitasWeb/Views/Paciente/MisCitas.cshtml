@model List<MediCitasWeb.Models.Cita>
@{
    ViewBag.Title = "Mis Citas Médicas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="misCitasApp" data-page="mis-citas">

    <!-- HEADER CON BOTONES -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-journal-medical me-2"></i>Mis Citas Médicas
            </h2>
            <p class="text-muted mb-0">Historial y gestión de tus citas</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("AgendarCita", "Paciente")" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Agendar Nueva
            </a>
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    <!-- CONTADOR DE CITAS -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:12px">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-primary rounded-pill px-3 py-2">
                        <i class="bi bi-calendar-check me-1"></i>Total: @Model.Count citas
                    </span>
                    <span class="badge bg-success rounded-pill px-3 py-2 ms-2">
                        <i class="bi bi-check-circle me-1"></i>Activas: @Model.Count(c => c.estado == "Activa")
                    </span>
                    <span class="badge bg-secondary rounded-pill px-3 py-2 ms-2">
                        <i class="bi bi-clock-history me-1"></i>Finalizadas: @Model.Count(c => c.estado != "Activa")
                    </span>
                </div>
                <div class="text-muted small">
                    <i class="bi bi-info-circle"></i> Puedes cancelar hasta 2 horas antes
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE CITAS -->
    <div class="card border-0 shadow-sm" style="border-radius:12px">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small text-uppercase">
                            <th class="px-4 py-3">Especialidad</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Doctor</th>
                            <th>Estado</th>
                            <th class="text-end px-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var doctorNombre = "No asignado";
                            if (ViewBag.Doctores != null && ((Dictionary<int, string>)ViewBag.Doctores).ContainsKey(c.id_doctor))
                            {
                                doctorNombre = ((Dictionary<int, string>)ViewBag.Doctores)[c.id_doctor];
                            }

                            var puedeCancelar = c.estado == "Activa" && c.fecha_cita > DateTime.Now.AddHours(2);
                            var puedeReprogramar = c.estado == "Activa" && c.fecha_cita > DateTime.Now;

                            <tr class="border-bottom" data-id="@c.id_cita">
                                <td class="px-4 py-3">
                                    <span class="badge bg-info-subtle text-info rounded-pill px-3">@c.especialidad</span>
                                </td>
                                <td class="fw-medium">@c.fecha_cita.ToString("dd/MM/yyyy")</td>
                                <td>@c.hora_cita.ToString(@"hh\:mm")</td>
                                <td>@doctorNombre</td>
                                <td>
                                    <span class="badge rounded-pill px-3 @(c.estado == "Activa" ? "bg-success" : "bg-secondary")">
                                        <i class="bi @(c.estado == "Activa" ? "bi-calendar-check" : "bi-check2-circle") me-1"></i>
                                        @c.estado
                                    </span>
                                </td>
                                <td class="text-end px-4">
                                    @if (c.estado == "Activa")
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border-0 rounded-circle" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick="verDetalleCita(@c.id_cita)">
                                                        <i class="bi bi-eye me-2"></i>Ver detalles
                                                    </a>
                                                </li>
                                                @if (puedeReprogramar)
                                                {
                                                    <li>
                                                        <a class="dropdown-item" href="#" onclick="reprogramarCita(@c.id_cita)">
                                                            <i class="bi bi-calendar-plus me-2"></i>Reprogramar
                                                        </a>
                                                    </li>
                                                }
                                                @if (puedeCancelar)
                                                {
                                                    <li>
                                                        <a class="dropdown-item text-danger" href="#" onclick="cancelarCita(@c.id_cita)">
                                                            <i class="bi bi-x-circle me-2"></i>Cancelar cita
                                                        </a>
                                                    </li>
                                                }
                                                else if (c.estado == "Activa" && c.fecha_cita <= DateTime.Now.AddHours(2))
                                                {
                                                    <li>
                                                        <a class="dropdown-item disabled text-muted" href="#">
                                                            <i class="bi bi-clock me-2"></i>Cancelación no disponible (menos de 2h)
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ESTADO VACÍO -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 mt-4">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">No tienes citas programadas</h5>
            <p class="text-muted">Agenda tu primera cita médica ahora</p>
            <a href="@Url.Action("AgendarCita", "Paciente")" class="btn btn-primary rounded-pill px-4 mt-2">
                <i class="bi bi-plus-lg me-2"></i>Agendar Cita
            </a>
        </div>
    }
</div>

<!-- MODAL DETALLE CITA -->
<div class="modal fade" id="modalDetalleCita" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
            <div class="modal-header border-0 bg-primary text-white p-4">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-calendar-check me-2"></i>Detalle de la Cita
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="detalleCitaContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted">Cargando detalles...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function cancelarCita(idCita) {
            const confirmacion = prompt('¿Estás seguro de cancelar esta cita?\n\nEscribe "CONFIRMAR" para proceder con la cancelación:');
            if (confirmacion !== 'CONFIRMAR') return;

            fetch('/Paciente/CancelarCita', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'idCita=' + idCita
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ Cita cancelada exitosamente');
                        location.reload();
                    } else {
                        alert('❌ Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('❌ Error al cancelar la cita');
                });
        }

        function reprogramarCita(idCita) {
            if (confirm('¿Reprogramar esta cita?\n\nSe te redirigirá al formulario para elegir una nueva fecha y hora.')) {
                window.location.href = `/Paciente/ReprogramarCita?idCita=${idCita}`;
            }
        }

        function verDetalleCita(idCita) {
            const modal = new bootstrap.Modal(document.getElementById('modalDetalleCita'));
            const contentDiv = document.getElementById('detalleCitaContent');

            contentDiv.innerHTML = `
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2 text-muted">Cargando detalles...</p>
                    </div>
                `;
            modal.show();

            fetch(`/Paciente/ObtenerDetalleCita?idCita=${idCita}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        contentDiv.innerHTML = `
                                <div class="bg-light p-3 rounded-3 mb-3">
                                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle me-2"></i>Información de la Cita</h6>
                                    <div class="row">
                                        <div class="col-6 mb-2"><strong>Especialidad:</strong></div>
                                        <div class="col-6 mb-2">${data.cita.especialidad || 'N/A'}</div>
                                        <div class="col-6 mb-2"><strong>Doctor:</strong></div>
                                        <div class="col-6 mb-2">${data.cita.doctor || 'N/A'}</div>
                                        <div class="col-6 mb-2"><strong>Fecha:</strong></div>
                                        <div class="col-6 mb-2">${data.cita.fecha || 'N/A'}</div>
                                        <div class="col-6 mb-2"><strong>Hora:</strong></div>
                                        <div class="col-6 mb-2">${data.cita.hora || 'N/A'}</div>
                                        <div class="col-6 mb-2"><strong>Tipo:</strong></div>
                                        <div class="col-6 mb-2">${data.cita.tipo || 'N/A'}</div>
                                        <div class="col-6 mb-2"><strong>Estado:</strong></div>
                                        <div class="col-6 mb-2">
                                            <span class="badge ${data.cita.estado === 'Activa' ? 'bg-success' : 'bg-secondary'}">${data.cita.estado}</span>
                                        </div>
                                        ${data.cita.observaciones ? `
                                        <div class="col-12 mt-2">
                                            <strong>Observaciones:</strong>
                                            <p class="text-muted small mb-0 mt-1">${data.cita.observaciones}</p>
                                        </div>
                                        ` : ''}
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                                </div>
                            `;
                    } else {
                        contentDiv.innerHTML = `
                                <div class="alert alert-danger">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    ${data.message || 'Error al cargar los detalles de la cita'}
                                </div>
                                <div class="d-flex justify-content-end mt-3">
                                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                                </div>
                            `;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    contentDiv.innerHTML = `
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Error al cargar los detalles de la cita
                            </div>
                            <div class="d-flex justify-content-end mt-3">
                                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        `;
                });
        }
    </script>

    <style>
        .dropdown-menu {
            min-width: 180px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

        .dropdown-item {
            font-size: 13px;
            padding: 8px 16px;
        }

            .dropdown-item:hover {
                background-color: #f8f9fa;
            }

            .dropdown-item.disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .badge {
            font-weight: 500;
        }
    </style>
}